{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "typeRoots": [
      ".local/tooling/node_modules/@types"
    ]
  },
  "include": [
    "shared/src/**/*.ts",
    "companion-agent/src/**/*.ts",
    "sillytavern/src/**/*.ts"
  ]
}
